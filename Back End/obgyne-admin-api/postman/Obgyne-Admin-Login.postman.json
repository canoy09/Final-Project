              "pm.test(\"Blocked without token\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Me - with doctor token",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{doctorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns logged-in doctor\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Role is doctor\", function () { pm.expect(pm.response.json().user.role).to.eql(\"doctor\"); });"
            ]
          }
        }
      ]
    },
