    {
      "name": "15. Failed attempts limit - wrong password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"secretary@clinic.test\",\n  \"password\": \"wrong-password\",\n  \"role\": \"secretary\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Click Send 5 times. Attempts 1-4 return 401. The 5th returns 429 with retryAfter (seconds). While locked, even the correct password is refused. Run `npm run seed` to unlock right away."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"401 (wrong password) or 429 (locked)\", function () { pm.expect([401, 429]).to.include(pm.response.code); });",
              "if (pm.response.code === 429) { pm.test(\"Has retryAfter\", function () { pm.expect(pm.response.json().retryAfter).to.be.above(0); }); }"
            ]
          }
        }
      ]
    }
  ],
